# Google OAuth Web Client ID。
GOOGLE_CLIENT_ID=

# 僅供 Vercel Function 使用的 OAuth Web Client Secret。
GOOGLE_CLIENT_SECRET=

# 正式網站固定 HTTPS 來源，用於建立 OAuth callback URL。
APP_ORIGIN=

# 以 32 random bytes 產生的 base64url 值，用於 AES-256-GCM 工作階段 Cookie。
SESSION_ENCRYPTION_KEY=

# 以 32 random bytes 產生的 base64url 值，用於 AES-256-GCM 資料庫 refresh token 加密。
TOKEN_ENCRYPTION_KEY=

# 目前 refresh token 加密金鑰版本識別碼。
TOKEN_ENCRYPTION_KEY_VERSION=

# Cloud Firestore Native mode 專案 ID。
FIRESTORE_PROJECT_ID=

# 僅供 Vercel Function 使用的 Firestore 服務帳號 JSON 憑證。
FIRESTORE_SERVICE_ACCOUNT_JSON=

# 以 node:crypto randomBytes(32) 產生的獨立 base64url ASCII 隨機值（至少 32 個字元）。
LEGACY_MIGRATION_SECRET=

# 以 node:crypto randomBytes(32) 產生且不同於 LEGACY_MIGRATION_SECRET 的 base64url ASCII 隨機值（至少 32 個字元）。
CRON_SECRET=
