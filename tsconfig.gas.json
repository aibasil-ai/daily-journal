{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.gas.tsbuildinfo",
    "target": "ES2019",
    "lib": ["ES2019"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["gas/src"],
  "exclude": ["gas/src/**/*.test.ts"]
}
